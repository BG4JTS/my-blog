---
// src/components/widget/EasterEggs.astro
// 纯客户端彩蛋合集
---

<script type="module">
  (function() {
    // =====================================================
    // 1. 标题悬浮彩虹特效
    // =====================================================
    function applyRainbowEffect() {
      const titleEl = document.querySelector('[data-pagefind-body]');
      if (titleEl && !titleEl.classList.contains('rainbow-hover')) {
        titleEl.classList.add('rainbow-hover');
      }
    }
    // 等待 DOM 加载
    setTimeout(applyRainbowEffect, 100);
    document.addEventListener('astro:page-load', function() {
      setTimeout(applyRainbowEffect, 100);
    });

    // =====================================================
    // 2. 头像旋转（悬停 360° 旋转）
    // =====================================================
    function applyAvatarRotation() {
      const selectors = [
        'img.avatar',
        '.profile-avatar img',
        '.sidebar img.rounded-full',
        '.sidebar .avatar',
        '[data-avatar]',
        'img[alt*="avatar"]',
        '.profile img',
        'img[src*="avatar"]',
        '.sidebar .rounded-full img',
        // Fuwari 常见头像结构
        '.profile .avatar',
        'header img.rounded-full',
        '.sidebar .flex img.rounded-full'
      ];

      let avatar = null;
      for (const sel of selectors) {
        try {
          const el = document.querySelector(sel);
          if (el && el.tagName === 'IMG' && el.src) {
            avatar = el;
            break;
          }
        } catch (_) { /* ignore */ }
      }

      // 如果还是找不到，尝试在侧边栏中找第一张圆形图片
      if (!avatar) {
        const sidebar = document.querySelector('.sidebar, aside');
        if (sidebar) {
          const imgs = sidebar.querySelectorAll('img');
          for (const img of imgs) {
            // 检查是否是圆形图片（头像通常有 rounded-full）
            if (img.classList.contains('rounded-full') || 
                img.className.includes('rounded') ||
                img.getAttribute('alt')?.toLowerCase().includes('avatar') ||
                img.getAttribute('alt')?.toLowerCase().includes('profile')) {
              avatar = img;
              break;
            }
          }
        }
      }

      if (!avatar || avatar.classList.contains('avatar-spin')) return;

      avatar.setAttribute('data-avatar', 'true');
      avatar.classList.add('avatar-spin');
      avatar.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';

      // 移除旧监听
      avatar.removeEventListener('mouseenter', avatar._spinEnter);
      avatar.removeEventListener('mouseleave', avatar._spinLeave);

      avatar._spinEnter = function() {
        this.style.transform = 'rotate(360deg)';
      };
      avatar._spinLeave = function() {
        this.style.transform = 'rotate(0deg)';
      };

      avatar.addEventListener('mouseenter', avatar._spinEnter);
      avatar.addEventListener('mouseleave', avatar._spinLeave);
    }

    // 延迟执行确保 DOM 加载
    setTimeout(applyAvatarRotation, 800);
    document.addEventListener('astro:page-load', function() {
      setTimeout(applyAvatarRotation, 500);
    });

  })();
</script>

<style is:global>
  /* ===== 标题彩虹悬停特效 ===== */
  .rainbow-hover {
    transition: all 0.3s ease;
    display: inline-block;
  }
  .rainbow-hover:hover {
    background: linear-gradient(
      135deg,
      #ff6b6b,
      #ffd93d,
      #6bcb77,
      #4d96ff,
      #9b59b6,
      #ff6b6b
    );
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: rainbowFlow 2s ease infinite;
  }
  @keyframes rainbowFlow {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>

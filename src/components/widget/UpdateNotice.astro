---
// src/components/widget/UpdateNotice.astro
export interface Props {
  published: Date;
  updated?: Date;
  thresholdDays?: number;
}

const { published, updated, thresholdDays = 3 } = Astro.props;

// 如果有更新日期，且更新日期晚于发布日期
const hasUpdate = updated && updated.getTime() > published.getTime();

// 计算距离今天的天数
const today = new Date();
let daysAgo = 0;
if (hasUpdate) {
  const diff = today.getTime() - updated.getTime();
  daysAgo = Math.floor(diff / (1000 * 60 * 60 * 24));
} else {
  const diff = today.getTime() - published.getTime();
  daysAgo = Math.floor(diff / (1000 * 60 * 60 * 24));
}

// 仅当超过阈值天数时显示提醒
const showNotice = (hasUpdate && daysAgo > thresholdDays) || (!hasUpdate && daysAgo > 30);
---

{showNotice && (
  <div class="update-notice mb-6 p-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/50 text-sm">
    <span class="text-amber-700 dark:text-amber-400">
      {hasUpdate ? (
        <>📝 本文最后更新于 <strong>{updated.toLocaleDateString('zh-CN')}</strong>（{daysAgo} 天前）</>
      ) : (
        <>📅 本文发布于 <strong>{published.toLocaleDateString('zh-CN')}</strong>（{daysAgo} 天前）</>
      )}
      <span class="text-amber-600 dark:text-amber-400/70 ml-2">
        内容可能已过时，建议结合最新信息阅读。
      </span>
    </span>
  </div>
)}